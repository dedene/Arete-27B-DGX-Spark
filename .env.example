# Copy to .env and uncomment what you want to change; `docker compose up -d --wait` picks it up.
# The values shown are the defaults baked into compose.yaml.

# Window per request (native 262144) and requests decoded together. Streams share a KV pool, so PARALLEL is a cap.
#CONTEXT=262144
#PARALLEL=4
#MAX_TOKENS=32768
# Thinking is what the template does by default, and what Hermes gets: 1 = on. A request can still send enable_thinking.
#ENABLE_THINKING=1
# dflash2 or none. Lossless: every drafted token is checked against the target.
#SPEC=dflash2
# bf16 keeps the KV cache exact. fp8 is smaller and lossy.
#KV_CACHE=bf16
#VISION=1

# Server sampling defaults, from the model's generation_config.json. Requests can override per call.
#TEMP=1.0
#TOP_P=0.95
#TOP_K=20

#SERVED_NAME=Arete-27B
#HOST=0.0.0.0
#PORT=8888
# Set to require a bearer token on the API.
#API_KEY=
#RESTART=no

#MODEL_ID=Duckets/Arete-27B-MLX-4bit
#MODEL_REVISION=bbbb47db81f9e057ab523b810cd7893384b1699c
#TENSORFOLD_IMAGE=arete-27b-tensorfold:1.2.3-r1
#MODEL_DIR=~/.cache/arete-27b
#KERNEL_CACHE=~/.cache/arete-27b/kernels
#HF_TOKEN=
